APP_ENV=development
APP_LOG_LEVEL=INFO

APP_JWT_SECRET_KEY=change-me-in-production
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_DEMO_PASSWORD=catl123

# PostgreSQL
APP_DATABASE_URL=postgresql+psycopg://supplyguard:123456@127.0.0.1:5432/supplyguard

# 队列：docker compose 起的 Redis（映射到 6380，避开本机已有实例）
APP_REDIS_URL=redis://localhost:6380/0

# 上传
APP_UPLOAD_DIRECTORY=data/uploads
APP_MAX_UPLOAD_SIZE_MB=20

APP_QDRANT_URL=http://localhost:6333
APP_QDRANT_COLLECTION=supplyguard_chunks

# 图谱实体语义索引：关键词召回不到时兜底
APP_QDRANT_ENTITY_COLLECTION=supplyguard_entities
# 关键词与向量各取 Top N，再用 RRF 融合
APP_ENTITY_KEYWORD_LIMIT=20
APP_ENTITY_VECTOR_LIMIT=20
APP_ENTITY_VECTOR_THRESHOLD=0.6
APP_ENTITY_VECTOR_MIN_QUERY_CHARS=2
APP_ENTITY_RRF_K=60

# Embedding：阿里百炼（OpenAI 兼容模式）
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_EMBEDDING_MODEL=text-embedding-v3
APP_EMBEDDING_DIMENSION=1024

# LLM：DeepSeek（OpenAI 兼容模式）
APP_LLM_API_KEY=
APP_LLM_BASE_URL=https://api.deepseek.com/v1
APP_LLM_MODEL=deepseek-chat
# 前端可选的模型；qwen-* 复用百炼的 key 与 base_url，缺少对应密钥的模型会自动隐藏
APP_LLM_AVAILABLE_MODELS=deepseek-chat,deepseek-reasoner,qwen-plus,qwen-max

APP_CHUNK_SIZE=800
APP_CHUNK_OVERLAP=120
APP_TOP_K=4

# SecureRAG：检索前按角色过滤，检索后复核
APP_SECURE_RAG_ENFORCE_ROLES=true
APP_SECURE_RAG_REVIEW_MAX_RETRIES=1
APP_SECURE_RAG_MAX_DROP_RATIO=0.5

# GraphRAG：供应链图谱
APP_NEO4J_URI=bolt://localhost:7687
APP_NEO4J_USER=neo4j
APP_NEO4J_PASSWORD=change-me
APP_NEO4J_DATABASE=neo4j
# 进入提示词的图谱路径条数
APP_GRAPH_EVIDENCE_LIMIT=15

# Memory
APP_MEMORY_SESSION_TTL_SECONDS=3600
APP_MEMORY_MAX_TURNS=10
APP_MEMORY_LONG_TERM_ENABLED=true
# 长期记忆用 LLM 生成摘要；密钥缺失或调用失败时自动回退到规则摘要
APP_MEMORY_SUMMARIZE_WITH_LLM=true
APP_MEMORY_SUMMARY_MAX_CHARS=120
# 留空使用 APP_LLM_MODEL
APP_MEMORY_SUMMARY_MODEL=
# 超过最近 N 轮的旧对话滚动压缩成会话摘要
APP_MEMORY_ROLLING_SUMMARY_ENABLED=true
APP_MEMORY_SESSION_SUMMARY_MAX_CHARS=300

# Benchmark
APP_BENCHMARK_MAX_CASES=200
APP_BENCHMARK_MIN_HIT_RATE=0.8
APP_BENCHMARK_REQUIRE_ZERO_LEAK=true

APP_REQUIRE_APPROVAL=true
APP_OUTPUT_POLICY_ENABLED=true

APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
